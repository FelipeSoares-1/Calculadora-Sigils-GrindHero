      ],
      "descriptionTranslations": [
        {
          "locale": "en",
          "name": "Increases the chance to provoke monsters with your attacks. The value is added directly to the skill at the moment of the attack; for example, if the skill has a 10% provoke chance and your sigil adds 2%, the total will be 12% chance."
        },
        {
          "locale": "pt",
          "name": "Aumenta a chance de provocar monstros em seus ataques. O valor é adicionado diretamente na habilidade no momento do ataque, por exemplo, se a habilidade possuir uma chance de provocar de 10% e o seu sigil tiver 2%, no total serão 12% de chance."
        },
        {
          "locale": "es",
          "name": "Aumenta la probabilidad de provocar monstruos con tus ataques. El valor se suma directamente a la habilidad en el momento del ataque; por ejemplo, si la habilidad tiene un 10% de probabilidad de provocar y tu sigil agrega un 2%, en total será un 12% de probabilidad."
        },
        {
          "locale": "pl",
          "name": "Zwiększa szansę na sprowokowanie potworów twoimi atakami. Wartość jest dodawana bezpośrednio do umiejętności w momencie ataku; na przykład, jeśli umiejętność ma 10% szansy na prowokację, a twój sygnet dodaje 2%, łącznie będzie to 12% szansy."
        }
      ],
